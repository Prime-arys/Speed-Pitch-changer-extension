{
  "name": "Speed-Pitch changer",
  "description": "Modify the speed with the pitch of a video or audio.",
  "private": true,
  "version": "2.0.0-dev",
  "type": "module",
  "scripts": {
    "dev:default": "wxt",
    "dev": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "npx cp-cli node_modules/signalsmith-stretch/SignalsmithStretch.mjs public/signalsmith-stretch-worklet.js && wxt prepare",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.19",
    "@webext-core/messaging": "^2.3.0",
    "@webext-core/storage": "^1.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^7.12.0",
    "signalsmith-stretch": "^1.3.2"
  },
  "devDependencies": {
    "@eslint/config-helpers": "0.5.1",
    "@eslint/js": "9.39.2",
    "@types/chrome": "0.1.33",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@types/web": "^0.0.318",
    "@vitejs/plugin-react": "^5.1.2",
    "@wxt-dev/module-react": "^1.1.5",
    "babel-plugin-react-compiler": "1.0.0",
    "cp-cli": "^2.0.0",
    "eslint": "9.39.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.23.2",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "17.0.0",
    "prettier": "3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.53.0",
    "wxt": "0.20.13"
  }
}
