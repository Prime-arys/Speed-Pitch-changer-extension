{
  "name": "Speed-Pitch changer",
  "description": "Modify the speed with the pitch of a video or audio.",
  "private": true,
  "version": "2.0.0-dev",
  "type": "module",
  "scripts": {
    "dev:default": "wxt",
    "dev": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "npx cp-cli node_modules/signalsmith-stretch/SignalsmithStretch.mjs public/signalsmith-stretch-worklet.js && wxt prepare",
    "lint": "eslint . --ext .ts,.tsx,.css",
    "lint:fix": "eslint . --ext .ts,.tsx,.css --fix"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.96.2",
    "@webext-core/messaging": "^2.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.14.0",
    "signalsmith-stretch": "^1.3.2",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/config-helpers": "0.5.4",
    "@eslint/css": "^1.1.0",
    "@eslint/js": "^9.39.4",
    "@rolldown/plugin-babel": "^0.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/chrome": "0.1.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web": "^0.0.345",
    "@vitejs/plugin-react": "^6.0.1",
    "@wxt-dev/module-react": "^1.2.2",
    "babel-plugin-react-compiler": "1.0.0",
    "cp-cli": "^2.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-better-tailwindcss": "^4.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "17.4.0",
    "prettier": "3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.58.0",
    "wxt": "0.20.20"
  }
}
