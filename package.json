{
  "name": "Speed-Pitch changer",
  "description": "Modify the speed with the pitch of a video or audio.",
  "private": true,
  "version": "2.0.0-dev",
  "type": "module",
  "scripts": {
    "dev:default": "wxt",
    "dev": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "npx cp-cli node_modules/signalsmith-stretch/SignalsmithStretch.mjs public/signalsmith-stretch-worklet.js && npx cp-cli node_modules/@soundtouchjs/audio-worklet/.dist/soundtouch-processor.js public/soundtouch-processor.js && wxt prepare",
    "lint": "eslint . --ext .ts,.tsx,.css",
    "lint:fix": "eslint . --ext .ts,.tsx,.css --fix"
  },
  "dependencies": {
    "@soundtouchjs/audio-worklet": "^2.0.4",
    "@tanstack/react-query": "^5.101.2",
    "@webext-core/messaging": "^3.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.1",
    "signalsmith-stretch": "^1.3.2",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/config-helpers": "0.6.0",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^9.39.4",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.2",
    "@types/audioworklet": "^0.0.100",
    "@types/chrome": "0.2.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/web": "^0.0.352",
    "@vitejs/plugin-react": "^6.0.3",
    "@wxt-dev/module-react": "^1.2.2",
    "babel-plugin-react-compiler": "1.0.0",
    "cp-cli": "^2.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.2.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.7.0",
    "prettier": "3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.62.1",
    "wxt": "0.20.27"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "spawn-sync@1.0.15": true
  }
}
